# Какой фреймворк фоновых задач использует API: celery | rq
TASK_BACKEND=celery

# Брокер сообщений (для Celery). RQ всегда использует REDIS_URL.
#   Redis:    redis://redis:6379/0
#   RabbitMQ: amqp://guest:guest@rabbitmq:5672//
BROKER_URL=redis://redis:6379/0

# Redis: result backend Celery и очередь RQ
REDIS_URL=redis://redis:6379/1

# Каталог артефактов отчётов (общий volume между api и воркерами)
ARTIFACTS_DIR=/data/artifacts

# Вероятность сбоя задачи уведомления (демонстрация retry), 0.0–1.0
NOTIFY_FAILURE_RATE=0.5
